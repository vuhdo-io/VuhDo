    VuhDoOptions/Libs/ChatThrottleLib: svn://svn.wowace.com/wow/chatthrottlelib/mainline/trunk


ignore:
    - Libs/LibOrbitGlow-1.0/Textures
    - wiki
	
move-folders:
    VuhDo/VuhDoOptions: VuhDoOptions